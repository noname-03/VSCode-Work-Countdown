{
  "name": "work-countdown",
  "displayName": "Work Countdown",
  "description": "Countdown timer for a 9-hour workday (8 hours work + 1 hour break). Set your start time and see the countdown in real-time.",
  "version": "1.0.0",
  "publisher": "local",
  "repository": {
    "type": "git",
    "url": "https://github.com/username/VSCode-Work-Countdown"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "workCountdown",
          "title": "Work Countdown",
          "icon": "$(watch)"
        }
      ]
    },
    "views": {
      "workCountdown": [
        {
          "id": "workCountdownView",
          "name": "Countdown",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "workcountdown.setStartTime",
        "title": "Work Countdown: Set Start Time"
      },
      {
        "command": "workcountdown.focusView",
        "title": "Work Countdown: Show Countdown"
      },
      {
        "command": "workcountdown.resetTimer",
        "title": "Work Countdown: Reset Timer"
      },
      {
        "command": "workcountdown.togglePause",
        "title": "Work Countdown: Pause/Resume Break"
      }
    ],
    "configuration": {
      "title": "Work Countdown",
      "properties": {
        "workcountdown.workDuration": {
          "type": "number",
          "default": 9,
          "description": "Total work duration in hours (default: 9 hours = 8 hours work + 1 hour break)"
        },
        "workcountdown.showSeconds": {
          "type": "boolean",
          "default": true,
          "description": "Show seconds in the countdown panel"
        },
        "workcountdown.alertBeforeEnd": {
          "type": "number",
          "default": 30,
          "description": "Show notification a few minutes before time ends (minutes)"
        }
      }
    }
  }
}